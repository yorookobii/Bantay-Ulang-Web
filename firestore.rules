rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // -------------------------------------------------------------------------
    // users
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Any authenticated user can read user documents.
      // Needed so the web admin login can fetch any user doc to verify their role.
      allow read: if isAuthenticated();

      // Users can write their own document; admins can write any user document.
      allow write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // settings
    // -------------------------------------------------------------------------
    match /settings/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // sensor_readings
    // -------------------------------------------------------------------------
    match /sensor_readings/{docId} {
      // Authenticated users (web + Flutter) can read.
      allow read: if isAuthenticated();

      // ESP32/Arduino writes without auth.
      allow create: if true;

      // Only admins can update or delete sensor readings.
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // alerts
    // -------------------------------------------------------------------------
    match /alerts/{docId} {
      allow read: if isAuthenticated();

      allow create, update: if true;

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // growth_indicators
    // -------------------------------------------------------------------------
    match /growth_indicators/{docId} {
      allow read: if isAuthenticated();

      allow create, delete: if isAdmin();

      allow update: if isAdmin() ||
                       (isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['survivalRate', 'avgWeightPerPiece', 'expectedYield']));
    }

    // -------------------------------------------------------------------------
    // ulang_growth_records
    // -------------------------------------------------------------------------
    match /ulang_growth_records/{docId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                       request.resource.data.recordedBy == request.auth.uid;

      allow update: if isAdmin() ||
                       (isAuthenticated() &&
                        resource.data.recordedBy == request.auth.uid);

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // mortality_records
    // -------------------------------------------------------------------------
    match /mortality_records/{docId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                       request.resource.data.recordedBy == request.auth.uid;

      allow update: if isAdmin() ||
                       (isAuthenticated() &&
                        resource.data.recordedBy == request.auth.uid);

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // feeding_records
    // -------------------------------------------------------------------------
    match /feeding_records/{docId} {
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // feeding_schedules
    // Arduino R4 needs unauthenticated READ access so it can retrieve:
    // enabled, feedTime, amount, feedType
    // Writes remain authenticated only.
    // -------------------------------------------------------------------------
    match /feeding_schedules/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // Aquaponics
    // Single live doc: Aquaponics/Ulang
    // -------------------------------------------------------------------------
    match /Aquaponics/{docId} {
      allow read: if isAuthenticated();

      // Arduino can create/update live sensor data.
      allow create, update: if true;

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // readings
    // Actual path example:
    // HistoryLogs/Ulang/years/{Y}/{M}/{D}/readings/{docId}
    // -------------------------------------------------------------------------
    match /{path=**}/readings/{docId} {
      allow read: if isAuthenticated();

      // Arduino can CREATE a new reading or UPDATE an existing document
      // when the same document ID is encountered.
      allow create, update: if true;

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // ActionLogs
    //
    // Arduino path example:
    // ActionLogs/Ulang/years/action_2026/action_09/action_24/
    // actions/action_0002
    //
    // This rule was missing before, causing HTTP 403 PERMISSION_DENIED.
    // -------------------------------------------------------------------------
    match /ActionLogs/{actionDocument=**} {
      allow read: if isAuthenticated();

      // Arduino can create/update device-generated action logs.
      allow create, update: if true;

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // logs
    // -------------------------------------------------------------------------
    match /logs/{docId} {
      allow read: if isAdmin() ||
                    (isAuthenticated() &&
                     (resource.data.createdBy == request.auth.uid ||
                      resource.data.assignedTo == request.auth.uid));

      allow create: if isAuthenticated() &&
                       request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin() ||
                       (isAuthenticated() &&
                        resource.data.createdBy == request.auth.uid);

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // tasks
    // -------------------------------------------------------------------------
    match /tasks/{docId} {
      allow read: if isAdmin() ||
                    (isAuthenticated() &&
                     (resource.data.createdBy == request.auth.uid ||
                      resource.data.assignedTo == request.auth.uid ||
                      resource.data.createdBy == 'system'));

      allow create: if isAuthenticated() &&
                       (request.resource.data.createdBy == request.auth.uid ||
                        request.resource.data.createdBy == 'system');

      allow update: if isAdmin() ||
                       (isAuthenticated() &&
                        (resource.data.createdBy == request.auth.uid ||
                         resource.data.assignedTo == request.auth.uid ||
                         resource.data.createdBy == 'system'));

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Default deny — all other collections and documents are blocked.
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
