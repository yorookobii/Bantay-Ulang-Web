rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Approved account: own users doc exists with status 'active' (no role bypass; a missing doc is false).
    function isActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myDoc().data.get('status', '') == 'active';
    }

    function isAdmin() {
      return isActive() && myDoc().data.get('role', '') == 'admin';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // -------------------------------------------------------------------------
    // users
    // -------------------------------------------------------------------------
    match /users/{userId} {
      function isSelf() {
        return isAuthenticated() && request.auth.uid == userId;
      }

      // Self-signup: a pending, unverified farm user with a fixed field set only.
      function isValidSelfCreate() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'fullName', 'role', 'status', 'emailVerified', 'createdAt'])
          && d.role == 'user'
          && d.status == 'pending'
          && d.emailVerified == false
          && d.email is string && d.email.lower() == request.auth.token.email
          && d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 80
          && d.createdAt == request.time;
      }

      // Self edit: profile fields only, or emailVerified false -> true on its own.
      // No token check: signup.dart:300 writes emailVerified after user.reload(), which does
      // not refresh the ID token. Tighten to request.auth.token.email_verified once the app
      // calls getIdToken(true) before that write. Admin approval (status) is the real gate.
      function isValidSelfUpdate() {
        let d = request.resource.data;
        let keys = d.diff(resource.data).affectedKeys();
        return (keys.hasOnly(['fullName', 'address'])
                 && (!('fullName' in keys) || (d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 80))
                 && (!('address' in keys) || (d.address is string && d.address.size() <= 200)))
          || (keys.hasOnly(['emailVerified'])
                 && resource.data.get('emailVerified', false) == false
                 && d.emailVerified == true);
      }

      // Admins read all; others read only their own doc, by uid or by the staff login email query.
      allow read: if isAdmin() || isSelf()
                  || (isAuthenticated() && resource.data.email == request.auth.token.email);

      allow create: if isAdmin() || (isSelf() && isValidSelfCreate());

      // Admins manage other users but can't change their own role/status (single-admin lockout guard).
      allow update: if (isAdmin() && !(isSelf() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])))
                    || (isSelf() && isValidSelfUpdate());

      allow delete: if isAdmin() && !isSelf();
    }

    // -------------------------------------------------------------------------
    // settings
    // -------------------------------------------------------------------------
    match /settings/{docId} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // sensor_readings
    // -------------------------------------------------------------------------
    match /sensor_readings/{docId} {
      // Approved users (web + Flutter) can read.
      allow read: if isActive();

      // ESP32/Arduino writes without auth.
      allow create: if true;

      // Only admins can update or delete sensor readings.
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // alerts
    // -------------------------------------------------------------------------
    match /alerts/{docId} {
      allow read: if isActive();

      // Written only by the web alerts engine on admin pages.
      allow create, update: if isAdmin();

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // growth_indicators
    // -------------------------------------------------------------------------
    match /growth_indicators/{docId} {
      allow read: if isActive();

      allow create, delete: if isAdmin();

      // Practitioners may only write survivalRate (logs.dart recalculation); everything else is admin-only.
      allow update: if isAdmin()
                    || (isActive()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['survivalRate'])
                        && request.resource.data.survivalRate is number
                        && request.resource.data.survivalRate >= 0
                        && request.resource.data.survivalRate <= 100);
    }

    // -------------------------------------------------------------------------
    // ulang_growth_records
    // -------------------------------------------------------------------------
    match /ulang_growth_records/{docId} {
      allow read: if isActive();

      allow create: if isActive() &&
                       request.resource.data.recordedBy == request.auth.uid;

      allow update: if isAdmin() ||
                       (isActive() &&
                        resource.data.recordedBy == request.auth.uid);

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // mortality_records
    // -------------------------------------------------------------------------
    match /mortality_records/{docId} {
      allow read: if isActive();

      allow create: if isActive() &&
                       request.resource.data.recordedBy == request.auth.uid;

      allow update: if isAdmin() ||
                       (isActive() &&
                        resource.data.recordedBy == request.auth.uid);

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // feeding_records
    // -------------------------------------------------------------------------
    match /feeding_records/{docId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // feeding_schedules
    // Arduino R4 needs unauthenticated READ access so it can retrieve:
    // enabled, feedTime, amount, feedType
    // Writes are admin-only (automation page).
    // -------------------------------------------------------------------------
    match /feeding_schedules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Aquaponics
    // Single live doc: Aquaponics/Ulang
    // -------------------------------------------------------------------------
    match /Aquaponics/{docId} {
      allow read: if isActive();

      // Arduino can create/update live sensor data.
      allow create, update: if true;

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // readings
    // Actual path example:
    // HistoryLogs/Ulang/years/{Y}/{M}/{D}/readings/{docId}
    // -------------------------------------------------------------------------
    match /{path=**}/readings/{docId} {
      allow read: if isActive();

      // Arduino can CREATE a new reading or UPDATE an existing document
      // when the same document ID is encountered.
      allow create, update: if true;

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // ActionLogs
    //
    // Arduino path example:
    // ActionLogs/Ulang/years/action_2026/action_09/action_24/
    // actions/action_0002
    //
    // This rule was missing before, causing HTTP 403 PERMISSION_DENIED.
    // -------------------------------------------------------------------------
    match /ActionLogs/{actionDocument=**} {
      allow read: if isActive();

      // Arduino can create/update device-generated action logs.
      allow create, update: if true;

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // logs
    // -------------------------------------------------------------------------
    match /logs/{docId} {
      allow read: if isAdmin() ||
                    (isActive() &&
                     (resource.data.createdBy == request.auth.uid ||
                      resource.data.assignedTo == request.auth.uid));

      allow create: if isActive() &&
                       request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin() ||
                       (isActive() &&
                        resource.data.createdBy == request.auth.uid);

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // tasks
    // -------------------------------------------------------------------------
    match /tasks/{docId} {
      allow read: if isAdmin() ||
                    (isActive() &&
                     (resource.data.createdBy == request.auth.uid ||
                      resource.data.assignedTo == request.auth.uid));

      // Only admin pages create tasks (Assign Actions and the alerts engine's 'system' tasks).
      allow create: if isAdmin() &&
                       (request.resource.data.createdBy == request.auth.uid ||
                        request.resource.data.createdBy == 'system');

      // Assignees may only change status (technician and mobile mark-done).
      allow update: if isAdmin() ||
                       (isActive() &&
                        resource.data.assignedTo == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Default deny — all other collections and documents are blocked.
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
